{
  "name": "Postalytics",
  "api_name": "postalytics",
  "version": "0.0.75",
  "description": "Send direct mail postcards and letters through Postalytics.",
  "external_link": "",
  "release_branches": ["KZN-15650-add-field-name-mappings-to-postalytics-config"],
  "release_environments": ["dev"],
  "engine": "1.0.0",
  "entry": "src/",
  "release_notes_directory": "releaseNotes/",
  "config_template": {},
  "base_config": {
    "secrets": ["api_key"]
  },
  "published": true,
  "services": [
    {
      "auth_type": "basic_auth_token_provided",
      "display_name": "Postalytics Dev",
      "service_name": "dev",
      "base_service_url": "https://api-dev.postalytics.com/api/v1/",
      "required_entitlement": "postalytics_enabled",
      "auth_level": "global",
      "auth_credentials": {
        "integration_secret_api_name": "postalytics__api_key"
      }
    },
    {
      "auth_type": "basic_auth_token_provided",
      "display_name": "Postalytics Prod",
      "service_name": "prod",
      "base_service_url": "https://api.postalytics.com/api/v1/",
      "required_entitlement": "postalytics_enabled",
      "auth_level": "global",
      "auth_credentials": {
        "integration_secret_api_name": "postalytics__api_key"
      }
    }
  ],
  "setup_assistant": {
    "actions": ["sendmail"],
    "fields": [
      {
        "type": "description",
        "content": "Map your Kizen fields to Postalytics fields for accurate mail delivery. Default Contact mappings are provided."
      },
      {
        "type": "field",
        "label": "First Name",
        "required": true,
        "match_hint": "first_name",
        "object_id": "client_client"
      },
      {
        "type": "field",
        "label": "Last Name",
        "required": true,
        "match_hint": "last_name",
        "object_id": "client_client"
      },
      {
        "type": "field",
        "label": "Street Address 1",
        "required": true,
        "match_hint": "street_address_1",
        "object_id": "client_client"
      },
      {
        "type": "field",
        "label": "Street Address 2",
        "required": false,
        "match_hint": "street_address_2",
        "object_id": "client_client"
      },
      {
        "type": "field",
        "label": "City",
        "required": true,
        "match_hint": "city",
        "object_id": "client_client"
      },
      {
        "type": "field",
        "label": "State",
        "required": true,
        "match_hint": "state",
        "object_id": "client_client"
      },
      {
        "type": "field",
        "label": "Zip Code",
        "required": true,
        "match_hint": "zipcode",
        "object_id": "client_client"
      }
    ]
  }
}
