{
  "name": "Send Drip Campaign",
  "plugin_description": "Integrates with Postalytics to send mail campaigns",
  "action_description": "Send a drip campaign to the target contact",
  "runtime": "python-3-13",
  "action_type": "do_not_use",
  "secrets": ["api_key"],
  "script": "script.js",
  "inputs": [
    {
      "name": "campaign_id",
      "label": "Campaign ID",
      "data_type": "string",
      "required": true,
      "input_source": "variable",
      "hint_variable_name": "Campaign Endpoint ID (eg aBcdEfghiJKlmNOP)",
      "script_alias": "campaignId"
    },
    {
      "name": "contact_first_name",
      "label": "First Name",
      "data_type": "string",
      "required": true,
      "input_source": "object_field",
      "hint_field_name": "First Name",
      "script_alias": "firstName"
    }
  ],
  "outputs": []
}
