{
  "name": "Send Drip Campaign",
  "plugin_description": "Integrates with Postalytics to send mail campaigns",
  "action_description": "Send a drip campaign to the target contact",
  "runtime": "python-3-13",
  "action_type": "do_not_use",
  "secrets": ["api_key"],
  "script": "script.js",
  "inputs": [
    {
      "name": "campaign_id",
      "label": "Campaign ID",
      "data_type": "string",
      "required": true,
      "input_source": "variable",
      "hint_variable_field_name": "endpoint",
      "script_alias": "campaignId"
    },
    {
      "name": "input_first_name",
      "label": "First Name",
      "data_type": "string",
      "required": true,
      "input_source": "object_field",
      "hint_field_name": "first_name",
      "script_alias": "firstName"
    },
    {
      "name": "input_last_name",
      "label": "Last Name",
      "data_type": "string",
      "required": true,
      "input_source": "object_field",
      "hint_field_name": "last_name",
      "script_alias": "lastName"
    },
    {
      "name": "input_email",
      "label": "Email",
      "data_type": "string",
      "required": true,
      "input_source": "object_field",
      "hint_field_name": "email",
      "script_alias": "email"
    },
    {
      "name": "input_address_street",
      "label": "Address Street",
      "data_type": "string",
      "required": true,
      "input_source": "object_field",
      "hint_field_name": "street_address_1",
      "script_alias": "addressStreet"
    },
    {
      "name": "input_address_street2",
      "label": "Address Street 2",
      "data_type": "string",
      "required": false,
      "input_source": "object_field",
      "hint_field_name": "street_address_2",
      "script_alias": "addressStreet2"
    },
    {
      "name": "input_address_city",
      "label": "Address City",
      "data_type": "string",
      "required": true,
      "input_source": "object_field",
      "hint_field_name": "city",
      "script_alias": "addressCity"
    },
    {
      "name": "input_address_state",
      "label": "Address State",
      "data_type": "string",
      "required": true,
      "input_source": "object_field",
      "hint_field_name": "state",
      "script_alias": "addressState"
    },
    {
      "name": "input_address_zip",
      "label": "Address ZIP",
      "data_type": "string",
      "required": true,
      "input_source": "object_field",
      "hint_field_name": "zipcode",
      "script_alias": "addressZip"
    },
    {
      "name": "input_phone_mobile",
      "label": "Phone Mobile",
      "data_type": "string",
      "required": false,
      "input_source": "object_field",
      "hint_field_name": "mobile_phone",
      "script_alias": "phoneMobile"
    },
    {
      "name": "input_phone_home",
      "label": "Phone Home",
      "data_type": "string",
      "required": false,
      "input_source": "object_field",
      "hint_field_name": "home_phone",
      "script_alias": "phoneHome"
    }
  ],
  "outputs": []
}
